# ==============================================================================
# TMDB API Configuration (CineScope - Movie Discovery App)
# Get your free TMDB API key at: https://www.themoviedb.org/settings/api
# ==============================================================================

# Base API URL
EXPO_PUBLIC_TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Base Image CDN URL
EXPO_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# TMDB v3 API Key (Required if Access Token is not provided)
EXPO_PUBLIC_TMDB_API_KEY=YOUR_TMDB_V3_API_KEY_HERE

# TMDB v4 Read Access Bearer Token (Recommended for secure Bearer header authorization)
EXPO_PUBLIC_TMDB_ACCESS_TOKEN=YOUR_TMDB_V4_READ_ACCESS_TOKEN_HERE
